# Copy to deploy/production.env on the server and fill in real values. production.env is
# gitignored: never commit it. docker-compose.yml passes every line to both containers as
# environment variables; backup.ps1, restore.ps1 and release.ps1 read it too.

# PostgreSQL. Generate a long random password; it appears twice below.
POSTGRES_DB=cardcreator
POSTGRES_USER=cardcreator
POSTGRES_PASSWORD=REPLACE_ME

# The app's connection string. The host is the compose service name, not localhost.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=cardcreator;Username=cardcreator;Password=REPLACE_ME

# Client IPs allowed to create a Collection (docs/spec.md, section 3). Add __1, __2, ... for more.
CollectionCreation__AllowedIps__0=REPLACE_ME

# Where backup.ps1 writes database dumps and Artwork archives (a Windows path), and how many
# days to keep them. Retention defaults to 14 if unset.
BACKUP_DIR=C:\Users\REPLACE_ME\OneDrive\Backups\Websites\cardcreator
BACKUP_RETENTION_DAYS=14
